<odoo>
<record id="test_outsource_work_object_default_view_form" model="ir.ui.view">
    <field name="name">test_outsource_work_object_default.form</field>
    <field name="model">test_outsource_work_object_default</field>
    <field name="arch" type="xml">
        <form>
            <sheet>
                <group>
                    <field name="name" />
                </group>
                <notebook>
                    <page name="page_general" string="General">
                        <field name="name" />
                    </page>
                </notebook>
            </sheet>
        </form>
    </field>
</record>

<record id="test_outsource_work_object_default_action" model="ir.actions.act_window">
    <field name="name">Test Outsource Work Object - Default</field>
    <field name="res_model">test_outsource_work_object_default</field>
    <field name="view_mode">tree,form</field>
</record>

<record id="test_outsource_work_object_enabled_view_form" model="ir.ui.view">
    <field name="name">test_outsource_work_object_enabled.form</field>
    <field name="model">test_outsource_work_object_enabled</field>
    <field name="arch" type="xml">
        <form>
            <sheet>
                <group>
                    <field name="name" />
                </group>
                <notebook>
                    <page name="page_general" string="General">
                        <field name="name" />
                    </page>
                </notebook>
            </sheet>
        </form>
    </field>
</record>

<record id="test_outsource_work_object_enabled_action" model="ir.actions.act_window">
    <field name="name">Test Outsource Work Object - Enabled</field>
    <field name="res_model">test_outsource_work_object_enabled</field>
    <field name="view_mode">tree,form</field>
</record>
</odoo>
